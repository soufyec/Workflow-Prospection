# Gmail sender account
SENDER_EMAIL=hello@yourdomain.com
SENDER_NAME=Your Name

# Gmail signature (HTML)
GMAIL_SIGNATURE=

# LinkedIn credentials (used for scraping VC posts)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# File paths (defaults shown — override only if needed)
CREDENTIALS_PATH=credentials/credentials.json
TOKEN_PATH=credentials/token.json
LINKEDIN_SESSION_PATH=credentials/linkedin_session.json
PIPELINE_PATH=data/pipeline.json
SENT_LOG_PATH=data/sent_log.csv
REVIEW_DIR=review/
TEMPLATE_PATH=templates/prospection_email.html
VC_LIST_PATH=config/vc_list.json

# Scraping throttle (seconds)
REQUEST_DELAY_MIN=1.5
REQUEST_DELAY_MAX=4.0
MAX_RETRIES=3

# ── Email discovery APIs ──────────────────────────────────────────────────────
# Apollo.io — https://developer.apollo.io/
APOLLO_API_KEY=

# FindyMail — https://app.findymail.com/  (find by name + domain, verify)
FINDYMAIL_API_KEY=

# Prospeo — https://prospeo.io/  (domain search + email finder)
PROSPEO_API_KEY=

# IcyPeas — https://icypeas.com/  (email search by name + domain)
ICYPEAS_API_KEY=

# LeadMagic — https://leadmagic.io/  (email finder by name + domain)
LEADMAGIC_API_KEY=

# Wiza — https://wiza.co/  (LinkedIn URL → email)
WIZA_API_KEY=

# ContactOut — https://contactout.com/  (LinkedIn URL → email)
CONTACTOUT_API_KEY=

# Follow-up timing (days after previous email)
FOLLOWUP_1_DAYS=5
FOLLOWUP_2_DAYS=12
FOLLOWUP_3_DAYS=21
